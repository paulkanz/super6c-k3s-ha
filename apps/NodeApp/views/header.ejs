<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title><%= page_title %> | Edge IIoT Reference Architecture</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" crossorigin="anonymous">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #333;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
            border-bottom: 2px solid #374151;
        }
        .card {
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid #e5e7eb;
            margin-bottom: 20px;
        }
        .card-header {
            background-color: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            font-weight: 600;
        }
        .badge-subtle {
            font-size: 0.85rem;
            padding: 0.35em 0.65em;
        }
        .metric-card {
            background: #ffffff;
            border-left: 4px solid #3b82f6;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1f2937;
        }
        .metric-label {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6b7280;
            font-weight: 600;
        }
        .soil-depth-badge {
            display: inline-block;
            width: 75px;
            font-weight: 600;
            font-size: 0.8rem;
        }
        .table-custom th {
            background-color: #f3f4f6;
            color: #374151;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
    <div class="container-fluid">
        <a class="navbar-brand font-weight-bold" href="/nodeapp/temp">
            <i class="fas fa-seedling text-success mr-2"></i>Precision Viticulture IIoT
        </a>
        <span class="navbar-text d-none d-md-inline text-muted small mr-auto">
            Edge Environmental &amp; Soil Moisture Telemetry
        </span>

        <ul class="navbar-nav ml-auto flex-row align-items-center">
            <li class="nav-item mr-3">
                <a class="nav-link <%= (active_tab === 'sensors') ? 'active font-weight-bold text-white' : 'text-light' %>" href="/nodeapp/temp">
                    <i class="fas fa-water mr-1"></i>Canopy &amp; Soil Profiles
                </a>
            </li>
            <li class="nav-item mr-3">
                <a class="nav-link <%= (active_tab === 'messages') ? 'active font-weight-bold text-white' : 'text-light' %>" href="/nodeapp/messages">
                    <i class="fas fa-broadcast-tower mr-1"></i>LoRaWAN Uplinks
                </a>
            </li>
            <li class="nav-item">
                <% if (db_connected) { %>
                    <span class="badge badge-primary badge-subtle shadow-sm">
                        <i class="fas fa-database mr-1"></i>MySQL Live (<%= db_host %>)
                    </span>
                <% } else { %>
                    <span class="badge badge-success badge-subtle shadow-sm" title="Running in autonomous simulated telemetry mode. Connect MySQL to persist real readings.">
                        <i class="fas fa-satellite-dish mr-1"></i>Autonomous Demo Mode (Simulated Telemetry)
                    </span>
                <% } %>
            </li>
        </ul>
    </div>
</nav>
<div class="container-fluid px-4">
