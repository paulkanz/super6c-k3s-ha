<%- include('header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 font-weight-bold text-dark">
            <i class="fas fa-chart-area text-primary mr-2"></i>Vineyard Microclimate &amp; Soil Moisture Profile
        </h4>
        <p class="text-muted small mb-0">
            Real-time telemetry supporting precision irrigation scheduling across vineyard management blocks
        </p>
    </div>
    <div>
        <a href="/nodeapp/temp" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-sync-alt mr-1"></i>Refresh Telemetry
        </a>
    </div>
</div>

<% if (!db_connected) { %>
<div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
    <strong><i class="fas fa-info-circle mr-1"></i> Autonomous Demonstration Mode Active:</strong>
    Displaying live simulated sensor telemetry with realistic micro-variations. 
    To record and persist historical telemetry, configure a MySQL or MariaDB instance using the included schema in <code>apps/NodeApp/db/schema.sql</code>.
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<% } %>

<!-- Station Telemetry Cards -->
<div class="row">
    <% if (stations && stations.length) { %>
        <% stations.forEach(function(station) { %>
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge badge-dark mr-1"><%= station.node_id %></span>
                        <strong><%= station.location %></strong>
                    </div>
                    <span class="badge <%= (station.irrigation_urgency === 'Irrigate Soon') ? 'badge-warning' : 'badge-success' %> badge-pill">
                        <%= station.irrigation_status %>
                    </span>
                </div>
                <div class="card-body">
                    <!-- Station Meta Info -->
                    <div class="d-flex justify-content-between text-muted small pb-2 mb-3 border-bottom">
                        <span><i class="fas fa-wine-glass-alt mr-1"></i>Variety: <strong><%= station.variety %></strong></span>
                        <span><i class="fas fa-battery-three-quarters text-success mr-1"></i><%= station.volts %>V</span>
                        <span><i class="fas fa-signal text-info mr-1"></i><%= station.rssi %> dBm</span>
                    </div>

                    <!-- 1. Canopy Microclimate (Temp & Moisture) -->
                    <h6 class="text-uppercase text-secondary font-weight-bold small mb-2">
                        <i class="fas fa-cloud-sun text-warning mr-1"></i>Canopy Microclimate
                    </h6>
                    <div class="row no-gutters mb-3">
                        <div class="col-6 pr-1">
                            <div class="metric-card" style="border-left-color: #f59e0b;">
                                <div class="metric-label">Canopy Temp</div>
                                <div class="metric-value"><%= station.canopy_temp %>&deg;F</div>
                                <div class="small text-muted">Ambient canopy air</div>
                            </div>
                        </div>
                        <div class="col-6 pl-1">
                            <div class="metric-card" style="border-left-color: #06b6d4;">
                                <div class="metric-label">Canopy Moisture</div>
                                <div class="metric-value"><%= station.canopy_humidity %>%</div>
                                <div class="small text-muted">Relative humidity</div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Soil Moisture Sensor (6 Values: 3 Depths Moisture & Temp) -->
                    <h6 class="text-uppercase text-secondary font-weight-bold small mb-2">
                        <i class="fas fa-layer-group text-primary mr-1"></i>Soil Profile (3 Depths &bull; 6 Telemetry Points)
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-center mb-0 table-custom">
                            <thead>
                                <tr>
                                    <th>Depth</th>
                                    <th>Soil Moisture</th>
                                    <th>Soil Temp</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Depth 1: Shallow (6") -->
                                <tr>
                                    <td class="font-weight-bold text-left">
                                        <span class="soil-depth-badge text-primary">6" Shallow</span>
                                    </td>
                                    <td>
                                        <strong><%= station.soil.d1_moisture %></strong> <span class="small text-muted">kPa</span>
                                    </td>
                                    <td>
                                        <%= station.soil.d1_temp %>&deg;F
                                    </td>
                                    <td>
                                        <span class="badge <%= (station.soil.d1_moisture > 45) ? 'badge-warning' : 'badge-light border' %>">
                                            <%= (station.soil.d1_moisture > 45) ? 'Drying' : 'Optimal' %>
                                        </span>
                                    </td>
                                </tr>

                                <!-- Depth 2: Root Zone (18") -->
                                <tr style="background-color: #f0fdf4;">
                                    <td class="font-weight-bold text-left">
                                        <span class="soil-depth-badge text-success">18" Root Zone</span>
                                    </td>
                                    <td>
                                        <strong class="text-success"><%= station.soil.d2_moisture %></strong> <span class="small text-muted">kPa</span>
                                    </td>
                                    <td>
                                        <%= station.soil.d2_temp %>&deg;F
                                    </td>
                                    <td>
                                        <span class="badge badge-success">Target</span>
                                    </td>
                                </tr>

                                <!-- Depth 3: Deep Subsoil (36") -->
                                <tr>
                                    <td class="font-weight-bold text-left">
                                        <span class="soil-depth-badge text-secondary">36" Subsoil</span>
                                    </td>
                                    <td>
                                        <strong><%= station.soil.d3_moisture %></strong> <span class="small text-muted">kPa</span>
                                    </td>
                                    <td>
                                        <%= station.soil.d3_temp %>&deg;F
                                    </td>
                                    <td>
                                        <span class="badge badge-light border">Reserve</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Valve Actuator Status -->
                    <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center text-muted small">
                        <span><i class="fas fa-faucet mr-1"></i>Valve Relay: <strong><%= station.valve_status %></strong></span>
                        <span><i class="fas fa-clock mr-1"></i><%= station.updated_ago %></span>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
    <% } else { %>
        <div class="col-12">
            <div class="alert alert-warning">No sensor telemetry currently available.</div>
        </div>
    <% } %>
</div>

<!-- Consolidated Soil & Microclimate Overview Table -->
<div class="card mt-2">
    <div class="card-header bg-white">
        <h5 class="mb-0 font-weight-bold text-dark">
            <i class="fas fa-table mr-2 text-primary"></i>Multi-Depth Soil &amp; Canopy Matrix (Fleet Overview)
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 table-custom text-center">
                <thead>
                    <tr>
                        <th class="text-left" rowspan="2" style="vertical-align: middle;">Station / Block</th>
                        <th colspan="2" class="bg-warning text-dark font-weight-bold">Canopy Microclimate</th>
                        <th colspan="2" class="bg-info text-white font-weight-bold">Depth 1: Shallow (6")</th>
                        <th colspan="2" class="bg-success text-white font-weight-bold">Depth 2: Root Zone (18")</th>
                        <th colspan="2" class="bg-secondary text-white font-weight-bold">Depth 3: Deep (36")</th>
                        <th rowspan="2" style="vertical-align: middle;">Battery</th>
                        <th rowspan="2" style="vertical-align: middle;">Signal</th>
                    </tr>
                    <tr>
                        <th>Temp</th>
                        <th>Moisture</th>
                        <th>Tension</th>
                        <th>Temp</th>
                        <th>Tension</th>
                        <th>Temp</th>
                        <th>Tension</th>
                        <th>Temp</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (stations && stations.length) { %>
                        <% stations.forEach(function(station) { %>
                        <tr>
                            <td class="text-left font-weight-bold">
                                <%= station.location %>
                                <div class="small text-muted font-weight-normal"><%= station.variety %> &bull; <%= station.node_id %></div>
                            </td>
                            <td><%= station.canopy_temp %>&deg;F</td>
                            <td><%= station.canopy_humidity %>%</td>
                            <td><strong><%= station.soil.d1_moisture %></strong> kPa</td>
                            <td><%= station.soil.d1_temp %>&deg;F</td>
                            <td class="text-success font-weight-bold"><%= station.soil.d2_moisture %> kPa</td>
                            <td><%= station.soil.d2_temp %>&deg;F</td>
                            <td><%= station.soil.d3_moisture %> kPa</td>
                            <td><%= station.soil.d3_temp %>&deg;F</td>
                            <td><%= station.volts %> V</td>
                            <td><%= station.rssi %> dBm</td>
                        </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('footer') %>
