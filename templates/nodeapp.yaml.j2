apiVersion: v1
kind: Namespace
metadata:
  name: nodeapp
  labels:
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/audit-version: latest
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/warn-version: latest
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: default
  namespace: nodeapp
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nodeapp-config
  namespace: nodeapp
data:
  DB_HOST: "{{ nodeapp_db_host }}"
  DB_PORT: "{{ nodeapp_db_port | string }}"
  DB_NAME: "{{ nodeapp_db_name }}"
  PORT: "{{ nodeapp_port | string }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: nodeapp-secret
  namespace: nodeapp
type: Opaque
stringData:
  DB_USER: "{{ nodeapp_db_user }}"
  DB_PASSWORD: "{{ nodeapp_db_password }}"
  SESSION_SECRET: "{{ nodeapp_session_secret }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nodeapp
  namespace: nodeapp
  labels:
    app: nodeapp
spec:
  replicas: {{ nodeapp_replicas | default(2) }}
  selector:
    matchLabels:
      app: nodeapp
  template:
    metadata:
      labels:
        app: nodeapp
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      nodeSelector:
        node.kubernetes.io/role: worker
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: nodeapp
      containers:
        - name: nodeapp
          image: {{ nodeapp_image | default('nodeapp:0.2.3') }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          ports:
            - containerPort: {{ nodeapp_port | default(4300) }}
              name: http
          envFrom:
            - configMapRef:
                name: nodeapp-config
            - secretRef:
                name: nodeapp-secret
          volumeMounts:
            - name: tmp
              mountPath: /tmp
          resources:
            requests:
              cpu: {{ nodeapp_cpu_request | default('100m') }}
              memory: {{ nodeapp_memory_request | default('128Mi') }}
            limits:
              cpu: {{ nodeapp_cpu_limit | default('500m') }}
              memory: {{ nodeapp_memory_limit | default('256Mi') }}
          readinessProbe:
            httpGet:
              path: /healthz
              port: {{ nodeapp_port | default(4300) }}
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: {{ nodeapp_port | default(4300) }}
            initialDelaySeconds: 15
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
      volumes:
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: nodeapp-service
  namespace: nodeapp
spec:
  type: ClusterIP
  selector:
    app: nodeapp
  ports:
    - name: http
      port: {{ nodeapp_port | default(4300) }}
      targetPort: {{ nodeapp_port | default(4300) }}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: nodeapp-redirect
  namespace: nodeapp
spec:
  redirectRegex:
    regex: "^(https?://[^/]+)/nodeapp$"
    replacement: "${1}/nodeapp/"
    permanent: true
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: nodeapp-redirect-https
  namespace: nodeapp
spec:
  redirectScheme:
    scheme: https
    permanent: true
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: nodeapp-security-headers
  namespace: nodeapp
spec:
  headers:
    stsSeconds: {{ traefik_hsts_seconds | default(31536000) }}
    stsIncludeSubdomains: {{ traefik_hsts_include_subdomains | default(true) | lower }}
    stsPreload: {{ traefik_hsts_preload | default(true) | lower }}
    customFrameOptionsValue: "{{ traefik_frame_options | default('SAMEORIGIN') }}"
    contentTypeNosniff: {{ traefik_content_type_nosniff | default(true) | lower }}
    browserXssFilter: {{ traefik_browser_xss_filter | default(true) | lower }}
    referrerPolicy: "{{ traefik_referrer_policy | default('strict-origin-when-cross-origin') }}"
    customResponseHeaders:
      Permissions-Policy: "{{ traefik_permissions_policy | default('geolocation=(), camera=(), microphone=()') }}"
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: nodeapp-ratelimit
  namespace: nodeapp
spec:
  rateLimit:
    average: {{ nodeapp_ratelimit_average | default(100) }}
    period: "{{ nodeapp_ratelimit_period | default('1m') }}"
    burst: {{ nodeapp_ratelimit_burst | default(30) }}
    sourceCriterion:
      ipStrategy: {}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: nodeapp-inflight
  namespace: nodeapp
spec:
  inFlightReq:
    amount: {{ nodeapp_inflight_max | default(15) }}
    sourceCriterion:
      ipStrategy: {}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: nodeapp-buffering
  namespace: nodeapp
spec:
  buffering:
    maxRequestBodyBytes: {{ nodeapp_buffering_max_body_bytes | default(2097152) }}
    memRequestBodyBytes: {{ nodeapp_buffering_mem_body_bytes | default(1048576) }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: nodeapp-ingress-http
  namespace: nodeapp
spec:
  entryPoints:
    - web
  routes:
    - match: PathPrefix(`/nodeapp`)
      kind: Rule
      middlewares:
        - name: nodeapp-ratelimit
        - name: nodeapp-redirect-https
        - name: nodeapp-redirect
      services:
        - name: nodeapp-service
          port: {{ nodeapp_port | default(4300) }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: nodeapp-ingress-https
  namespace: nodeapp
spec:
  entryPoints:
    - websecure
  routes:
    - match: PathPrefix(`/nodeapp`)
      kind: Rule
      middlewares:
        - name: nodeapp-ratelimit
        - name: nodeapp-inflight
        - name: nodeapp-buffering
        - name: nodeapp-security-headers
        - name: nodeapp-redirect
      services:
        - name: nodeapp-service
          port: {{ nodeapp_port | default(4300) }}
  tls:
    secretName: nodeapp-tls
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: nodeapp-tls
  namespace: nodeapp
spec:
  secretName: nodeapp-tls
  issuerRef:
    name: {{ acme_issuer_prod | default('letsencrypt-prod') }}
    kind: ClusterIssuer
  commonName: "{{ nodeapp_domain | default('nodeapp.example.com') }}"
  dnsNames:
    - "{{ nodeapp_domain | default('nodeapp.example.com') }}"
    - "{{ base_domain | default('example.com') }}"
    - "www.{{ base_domain | default('example.com') }}"
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: nodeapp-pdb
  namespace: nodeapp
spec:
  minAvailable: {{ nodeapp_pdb_min_available | default(1) }}
  selector:
    matchLabels:
      app: nodeapp
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nodeapp-isolation
  namespace: nodeapp
spec:
  podSelector:
    matchLabels:
      app: nodeapp
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # Allow Traefik Ingress Controller from kube-system
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: TCP
          port: {{ nodeapp_port | default(4300) }}
    # Allow Kubelet health check probes from host node subnet
    - from:
        - ipBlock:
            cidr: {{ admin_subnets[0] | default('192.168.1.0/24') }}
      ports:
        - protocol: TCP
          port: {{ nodeapp_port | default(4300) }}
  egress:
    # Allow DNS resolution via CoreDNS in kube-system
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    # Allow direct CoreDNS ClusterIP egress
    - to:
        - ipBlock:
            cidr: "{{ cluster_dns | default('10.43.0.10') }}/32"
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    # Allow MySQL database egress to dedicated host
    - to:
        - ipBlock:
            cidr: "{{ nodeapp_db_host }}/32"
      ports:
        - protocol: TCP
          port: {{ nodeapp_db_port | default(3306) }}
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: nodeapp-hpa
  namespace: nodeapp
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: nodeapp
  minReplicas: {{ nodeapp_hpa_min_replicas | default(2) }}
  maxReplicas: {{ nodeapp_hpa_max_replicas | default(5) }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ nodeapp_hpa_cpu_target | default(70) }}
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: {{ nodeapp_hpa_memory_target | default(80) }}



