apiVersion: v1
kind: Namespace
metadata:
  name: headlamp
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: default
  namespace: headlamp
automountServiceAccountToken: false
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: headlamp-admin
  namespace: headlamp
---
apiVersion: v1
kind: Secret
metadata:
  name: headlamp-admin-token
  namespace: headlamp
  annotations:
    kubernetes.io/service-account.name: headlamp-admin
type: kubernetes.io/service-account-token
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: headlamp-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: headlamp-admin
    namespace: headlamp
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: headlamp
  namespace: headlamp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: headlamp
  template:
    metadata:
      labels:
        app: headlamp
    spec:
      serviceAccountName: headlamp-admin
      containers:
        - name: headlamp
          image: {{ headlamp_image | default('ghcr.io/headlamp-k8s/headlamp:latest') }}
          args:
            - "-in-cluster"
            - "-base-url=/headlamp"
            - "-enable-helm"
          ports:
            - name: http
              containerPort: 4466
          resources:
            requests:
              cpu: {{ headlamp_cpu_request | default('100m') }}
              memory: {{ headlamp_memory_request | default('64Mi') }}
            limits:
              cpu: {{ headlamp_cpu_limit | default('500m') }}
              memory: {{ headlamp_memory_limit | default('256Mi') }}
          livenessProbe:
            httpGet:
              path: /headlamp/
              port: 4466
            initialDelaySeconds: 15
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /headlamp/
              port: 4466
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: headlamp
  namespace: headlamp
spec:
  type: ClusterIP
  selector:
    app: headlamp
  ports:
    - name: http
      port: 80
      targetPort: 4466
---
apiVersion: v1
kind: Service
metadata:
  name: headlamp-lb
  namespace: headlamp
spec:
  type: LoadBalancer
  selector:
    app: headlamp
  ports:
    - name: http
      port: {{ headlamp_port | default(8081) }}
      targetPort: 4466
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: headlamp-redirect
  namespace: headlamp
spec:
  redirectRegex:
    regex: "^(https?://[^/]+)/headlamp$"
    replacement: "${1}/headlamp/"
    permanent: true
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: headlamp-root-redirect
  namespace: headlamp
spec:
  redirectRegex:
    regex: "^(https?://[^/]+)/?$"
    replacement: "${1}/headlamp/"
    permanent: false
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: headlamp
  namespace: headlamp
spec:
  entryPoints:
    - web
  routes:
    - match: PathPrefix(`/headlamp`)
      kind: Rule
      middlewares:
        - name: headlamp-redirect
      services:
        - name: headlamp
          port: 80
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: admin-ip-allowlist
  namespace: headlamp
spec:
  ipAllowList:
    sourceRange:
{% for cidr in traefik_admin_allowlist_cidrs %}
      - "{{ cidr }}"
{% endfor %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: headlamp-security-headers
  namespace: headlamp
spec:
  headers:
    stsSeconds: {{ traefik_hsts_seconds | default(31536000) }}
    stsIncludeSubdomains: {{ traefik_hsts_include_subdomains | default(true) | lower }}
    stsPreload: {{ traefik_hsts_preload | default(true) | lower }}
    customFrameOptionsValue: "{{ traefik_frame_options | default('SAMEORIGIN') }}"
    contentTypeNosniff: {{ traefik_content_type_nosniff | default(true) | lower }}
    browserXssFilter: {{ traefik_browser_xss_filter | default(true) | lower }}
    referrerPolicy: "{{ traefik_referrer_policy | default('strict-origin-when-cross-origin') }}"
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: headlamp-domain
  namespace: headlamp
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`{{ headlamp_domain | default('headlamp.example.com') }}`) && (PathPrefix(`/headlamp`) || Path(`/`))
      kind: Rule
      middlewares:
        - name: admin-ip-allowlist
        - name: headlamp-security-headers
        - name: headlamp-redirect
        - name: headlamp-root-redirect
      services:
        - name: headlamp
          port: 80
  tls:
    secretName: headlamp-tls-secret
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: headlamp-tls
  namespace: headlamp
spec:
  secretName: headlamp-tls-secret
  issuerRef:
    name: {{ acme_issuer_prod | default('letsencrypt-prod') }}
    kind: ClusterIssuer
  dnsNames:
    - {{ headlamp_domain | default('headlamp.example.com') }}
